rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify admin authentication
    function isAdmin() {
      return request.auth != null;
    }

    // Registrations collection
    // Public can create their own registration with valid fields
    // Only authenticated admins can read, update, or delete
    match /registrations/{registrationId} {
      allow create: if request.resource.data.keys().hasAll(['fullName', 'email', 'phone', 'category', 'status'])
                    && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Certificates collection
    // Public can read certificates for verification
    // Only authenticated admins can create, update, or revoke
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Awards collection
    // Public can read awards for verification
    // Only authenticated admins can create, update, or revoke
    match /awards/{awardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Enquiries collection
    // Public can create new enquiries
    // Only authenticated admins can read, update status, or delete
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.keys().hasAll(['fullName', 'email', 'phone', 'message', 'status'])
                    && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }

    // Site Settings collection
    // Public can read settings
    // Only authenticated admins can update
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
